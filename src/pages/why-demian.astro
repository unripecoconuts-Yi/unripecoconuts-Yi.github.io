---
import Layout from '../layouts/Layout.astro';

// ─── Edit your story here ───
// The quote shown under the title, one sentence per line.
const quote = [
  'The bird fights its way out of the egg.',
  'The egg is the world.',
  'Who would be born must first destroy a world.',
  'The bird flies to God.',
  "That God's name is Abraxas.",
];
const quoteSource = 'Hermann Hesse, Demian';

// Each string in `story` becomes one paragraph.
const story = [
  "I was twenty, travelling through New Zealand, when I read Hermann Hesse's Demian. I'd look up from the page and there was that scenery, and I remember being completely happy right then. I've been Demian ever since.",
  "I kept the name when I came to Australia. It was only here that I found out Demian isn't an English name at all. It's German. For a moment I wondered whether I should change the spelling.",
  "But I've gone by it for so long now that I'm leaving it exactly as it is. If it ever causes a problem, I'll sort it out when I get there.",
];
const pronunciation = 'DEH-mee-ahn'; // how you say it; leave '' to hide
---

<Layout title="Why dEmiAn?" description="Why I go by Demian, and why it is spelled that way.">
  <article class="mx-auto max-w-3xl px-6 py-16 md:py-24">
    <p class="eyebrow reveal mb-6 flex items-center gap-3 text-accent-deep">
      <span class="h-1 w-8 bg-accent"></span>Easter egg
    </p>

    <!-- The odd capitals are the joke: E and A are the letters people swap -->
    <h1 class="reveal text-5xl leading-[1.05] font-extrabold tracking-tight sm:text-7xl">
      Why d<span class="text-accent-deep">E</span>mi<span class="text-accent-deep">A</span>n?
    </h1>

    <blockquote class="reveal reveal-delay mt-10 border-l-8 border-accent pl-6">
      <p class="text-xl leading-relaxed font-medium italic">
        {quote.map((line) => <span class="block">{line}</span>)}
      </p>
      <footer class="mt-4 font-semibold text-muted">— {quoteSource}</footer>
    </blockquote>

    <!-- Common misspellings, crossed out -->
    <ul class="mt-12 flex flex-wrap gap-x-6 gap-y-2 text-xl font-semibold text-muted" aria-label="Not my name">
      {['Damian', 'Damien', 'Demien', 'Demain'].map((n) => <li class="line-through decoration-accent decoration-2">{n}</li>)}
      <li class="font-extrabold text-ink">Demian ✓</li>
    </ul>

    <div class="mt-14 space-y-6 border-t-2 border-ink pt-12 text-lg leading-relaxed">
      {story.map((p) => <p>{p}</p>)}
    </div>

    {pronunciation && (
      <p class="mt-12 text-muted">
        Say it: <span class="font-bold text-ink">{pronunciation}</span>
      </p>
    )}

    <a href="/" class="btn btn-outline mt-14">
      ← Back to home
    </a>
  </article>
</Layout>
