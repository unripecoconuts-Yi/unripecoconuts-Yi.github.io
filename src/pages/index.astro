---
import Layout from '../layouts/Layout.astro';
import Gallery from '../components/Gallery.astro';
import { getEntry } from 'astro:content';
import { getSites, getGallery, byRegion, siteCount, period } from '../lib/sites';

const profile = (await getEntry('profile', 'profile'))!.data;
const sites = await getSites();
const regions = byRegion(sites);
const photos = (await getGallery()).filter((p) => p.data.featured);
const siteNames = Object.fromEntries(sites.map((s) => [s.id, s.data.name]));

const telHref = profile.phone ? `tel:+61${profile.phone.replace(/\D/g, '').replace(/^0/, '')}` : '';

const stats = [
  { value: siteCount(sites), label: 'Sites worked' },
  { value: profile.systems.length, label: 'Formwork systems' },
  { value: regions.length, label: 'QLD regions' },
];
---

<Layout>
  <!-- Hero -->
  <section class="mx-auto grid max-w-site items-end gap-12 px-6 pt-16 pb-20 md:grid-cols-[1.3fr_1fr] md:pt-24">
    <div class="reveal">
      <p class="mb-6 flex items-center gap-3 text-xs font-medium tracking-[0.2em] text-muted uppercase">
        <span class="h-px w-8 bg-accent"></span>
        {profile.role} · {profile.location}
      </p>
      <h1 class="text-5xl leading-[1.05] font-semibold tracking-tight sm:text-6xl lg:text-7xl">
        {profile.name}
        {profile.altName && <span class="block text-2xl font-normal tracking-normal text-muted sm:text-3xl">({profile.altName})</span>}
      </h1>
      <p class="mt-8 max-w-lg text-lg leading-relaxed text-muted">{profile.intro}</p>
      <div class="mt-10 flex flex-wrap gap-3 text-sm">
        <a href="#work" class="rounded-full bg-ink px-6 py-3 text-paper transition-opacity hover:opacity-85">View work</a>
        <a href="#contact" class="rounded-full border border-line px-6 py-3 transition-colors hover:border-ink">Get in touch</a>
      </div>
    </div>
    <figure class="reveal reveal-delay">
      <img
        src={profile.heroPhoto}
        alt={`${profile.name} on site in a hard hat and hi-vis`}
        width="1200"
        height={Math.round((1200 * Number(profile.heroRatio.split(':')[1])) / Number(profile.heroRatio.split(':')[0]))}
        style={`aspect-ratio: ${profile.heroRatio.replace(':', ' / ')}`}
        class="w-full bg-line object-cover"
        fetchpriority="high"
      />
    </figure>
  </section>

  <!-- Stats -->
  <section class="border-y border-line">
    <dl class="mx-auto grid max-w-site grid-cols-3 divide-x divide-line px-6">
      {stats.map((s) => (
        <div class="py-8 pr-4 pl-4 first:pl-0 sm:py-10 sm:pl-8">
          <dd class="text-3xl font-semibold tracking-tight sm:text-4xl">{s.value}</dd>
          <dt class="mt-1 text-xs text-muted sm:text-sm">{s.label}</dt>
        </div>
      ))}
    </dl>
  </section>

  <!-- What I do -->
  {profile.scope.length > 0 && (
    <section class="mx-auto max-w-site px-6 pt-24">
      <p class="mb-3 text-xs font-medium tracking-[0.2em] text-muted uppercase">What I do</p>
      <h2 class="mb-12 text-3xl font-semibold tracking-tight sm:text-4xl">From drawings to finished wall</h2>
      <ol class="grid gap-10 md:grid-cols-3">
        {profile.scope.map((step, i) => (
          <li class="border-t border-ink pt-5">
            <span class="text-xs text-muted tabular-nums">0{i + 1}</span>
            <h3 class="mt-2 text-lg font-medium">{step.title}</h3>
            <p class="mt-2 leading-relaxed text-muted">{step.text}</p>
          </li>
        ))}
      </ol>
    </section>
  )}

  <!-- Selected work -->
  <section id="work" class="mx-auto max-w-site scroll-mt-20 px-6 py-24">
    <header class="mb-12">
      <p class="mb-3 text-xs font-medium tracking-[0.2em] text-muted uppercase">Selected work</p>
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">Permanent formwork, on site</h2>
    </header>
    <Gallery photos={photos} siteNames={siteNames} />
  </section>

  <!-- Sites by region -->
  <section id="sites" class="scroll-mt-20 bg-white/60">
    <div class="mx-auto max-w-site px-6 py-24">
      <header class="mb-12">
        <p class="mb-3 text-xs font-medium tracking-[0.2em] text-muted uppercase">Site history</p>
        <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">Where I've worked</h2>
      </header>
      <div class="space-y-14">
        {regions.map((g) => (
          <div class="grid gap-4 md:grid-cols-[1fr_2fr] md:gap-12">
            <h3 class="flex items-baseline gap-3 pt-4 font-medium">
              {g.region}
              <span class="text-sm font-normal text-muted tabular-nums">{siteCount(g.sites)}</span>
            </h3>
            <ul class="divide-y divide-line border-y border-line">
              {g.sites.map((s) => (
                <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4">
                  <span class="font-medium">{s.data.name}</span>
                  <span class="text-sm text-muted">
                    {[s.data.address, s.data.type, period(s)].filter(Boolean).join(' · ')}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Next: TAFE -->
  {profile.tafe.show && (
    <section class="mx-auto max-w-site px-6 py-24">
      <div class="grid gap-6 border-l-2 border-accent pl-8 md:grid-cols-[1fr_2fr]">
        <p class="text-xs font-medium tracking-[0.2em] text-muted uppercase">Next · {profile.tafe.start}</p>
        <div>
          <h2 class="text-2xl font-semibold tracking-tight">{profile.tafe.institute}</h2>
          <p class="mt-2 text-muted">
            {profile.tafe.course}. Coursework and projects will be added here as I go.
          </p>
        </div>
      </div>
    </section>
  )}

  <!-- Contact -->
  <section id="contact" class="scroll-mt-20 bg-ink text-paper">
    <div class="mx-auto grid max-w-site gap-14 px-6 py-24 md:grid-cols-2">
      <div>
      <p class="mb-6 text-xs font-medium tracking-[0.2em] text-paper/60 uppercase">Contact</p>
      <h2 class="max-w-2xl text-3xl font-semibold tracking-tight sm:text-5xl">
        Need a formwork hand who knows {profile.systems.slice(0, 2).join(' and ')}? Let's talk.
      </h2>
      {profile.formEndpoint && <p class="mt-6 max-w-md text-paper/60">Send a message and I'll get back to you.</p>}
      <div class="mt-10 flex flex-wrap gap-x-10 gap-y-4 text-lg">
        {profile.phone && (
          <a href={telHref} class="underline decoration-paper/30 underline-offset-8 hover:decoration-accent">
            {profile.phone}
          </a>
        )}
        {profile.email && (
          <a href={`mailto:${profile.email}`} class="underline decoration-paper/30 underline-offset-8 hover:decoration-accent">
            {profile.email}
          </a>
        )}
        {profile.linkedin && (
          <a href={profile.linkedin} class="underline decoration-paper/30 underline-offset-8 hover:decoration-accent" rel="noopener">
            LinkedIn
          </a>
        )}
      </div>
      </div>

      <!-- Contact form via Formspree (free) — shown once formEndpoint is set in site.yaml -->
      {profile.formEndpoint && (
      <form
        method="POST"
        action={profile.formEndpoint}
        class="space-y-5 self-end"
      >
        <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />
        {[
          { name: 'name', label: 'Name', type: 'text', auto: 'name' },
          { name: 'contact', label: 'Email or phone', type: 'text', auto: 'email' },
        ].map((f) => (
          <label class="block">
            <span class="text-xs tracking-[0.15em] text-paper/60 uppercase">{f.label}</span>
            <input
              name={f.name}
              type={f.type}
              autocomplete={f.auto}
              required
              class="mt-2 w-full border-b border-paper/30 bg-transparent py-2 text-lg outline-none focus:border-accent"
            />
          </label>
        ))}
        <label class="block">
          <span class="text-xs tracking-[0.15em] text-paper/60 uppercase">Message</span>
          <textarea
            name="message"
            rows="4"
            required
            class="mt-2 w-full resize-y border-b border-paper/30 bg-transparent py-2 text-lg outline-none focus:border-accent"
          ></textarea>
        </label>
        <button type="submit" class="rounded-full bg-paper px-6 py-3 text-sm text-ink transition-opacity hover:opacity-85">
          Send message
        </button>
      </form>
      )}
    </div>
  </section>
</Layout>
