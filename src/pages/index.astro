---
import Layout from '../layouts/Layout.astro';
import Gallery from '../components/Gallery.astro';
import { getEntry } from 'astro:content';
import { getSites, getGallery, byRegion, siteCount, period } from '../lib/sites';
import { telHref, smsHref } from '../lib/contact';

const profile = (await getEntry('profile', 'profile'))!.data;
const sites = await getSites();
const regions = byRegion(sites);
const photos = (await getGallery()).filter((p) => p.data.featured);
const siteNames = Object.fromEntries(sites.map((s) => [s.id, s.data.name]));

const callHref = telHref(profile.phone);
const textHref = smsHref(profile.phone);
const hasContact = Boolean(profile.phone || profile.email || profile.linkedin || profile.formEndpoint);

const stats = [
  { value: siteCount(sites), label: 'Sites worked' },
  { value: profile.systems.length, label: 'Formwork systems' },
  { value: regions.length, label: 'QLD regions' },
];

const [ratioW, ratioH] = profile.heroRatio.split(':').map(Number);
const glance = [...profile.ready, profile.references].filter(Boolean);
---

<Layout>
  <!-- Top section: who I am, what I'm after, how to reach me -->
  <section class="bg-ink text-paper">
    <div class="mx-auto grid max-w-site items-center gap-10 px-6 pt-10 pb-14 md:grid-cols-[1.4fr_1fr] md:gap-14 md:pt-16 md:pb-20">
      <div class="reveal">
        <p class="eyebrow mb-5 flex items-center gap-3 text-accent">
          <span class="h-1 w-8 shrink-0 bg-accent"></span>
          {profile.location}
        </p>
        <h1 class="display text-6xl sm:text-7xl lg:text-8xl">
          {profile.name}
          {profile.altName && (
            <span class="mt-3 block text-xl font-semibold tracking-normal text-paper/60 normal-case sm:text-2xl">
              ({profile.altName})
            </span>
          )}
        </h1>
        <p class="mt-7 max-w-xl text-xl leading-snug font-semibold sm:text-2xl">{profile.seeking ?? profile.intro}</p>
        <div class="mt-9 flex flex-wrap gap-3">
          {callHref ? (
            <a href={callHref} class="btn btn-accent">Call {profile.phone}</a>
          ) : (
            hasContact && <a href="#contact" class="btn btn-accent">Get in touch</a>
          )}
          <a href="#work" class={`btn ${hasContact ? 'btn-outline-light' : 'btn-accent'}`}>View work</a>
        </div>
      </div>
      <figure class="reveal reveal-delay border-b-8 border-accent">
        <img
          src={profile.heroPhoto}
          alt={`${profile.name} on site in a hard hat and hi-vis`}
          width="1200"
          height={Math.round((1200 * ratioH) / ratioW)}
          style={`aspect-ratio: ${ratioW} / ${ratioH}`}
          class="w-full bg-paper/10 object-cover"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <!-- At a glance: tickets and the basics -->
  {(profile.tickets.length > 0 || glance.length > 0) && (
    <section class="border-b-2 border-ink" aria-labelledby="glance-title">
      <div class="mx-auto grid max-w-site gap-10 px-6 py-12 md:grid-cols-2 md:gap-14 md:py-14">
        {profile.tickets.length > 0 && (
          <div>
            <h2 id="glance-title" class="eyebrow mb-5 text-muted">Tickets</h2>
            <ul class="flex flex-wrap gap-2.5">
              {profile.tickets.map((t) => (
                <li class="border-2 border-ink px-3.5 py-2 text-base font-extrabold tracking-wide uppercase">{t}</li>
              ))}
            </ul>
          </div>
        )}
        {glance.length > 0 && (
          <div>
            <h2 id={profile.tickets.length ? undefined : 'glance-title'} class="eyebrow mb-5 text-muted">Ready to work</h2>
            <ul class="space-y-3 text-lg font-semibold">
              {glance.map((item) => (
                <li class="flex items-start gap-3">
                  <svg class="mt-0.5 h-6 w-6 shrink-0 bg-accent p-1 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="square" aria-hidden="true">
                    <path d="M4 12.5l5.5 5.5L20 6.5" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Numbers -->
  <section class="bg-accent text-ink">
    <dl class="mx-auto grid max-w-site grid-cols-3 px-6">
      {stats.map((s) => (
        <div class="border-l-2 border-ink/25 py-7 pr-2 pl-4 first:border-l-0 first:pl-0 sm:py-9 sm:pl-8">
          <dd class="display text-4xl sm:text-6xl">{s.value}</dd>
          <dt class="mt-2 text-sm leading-tight font-bold sm:text-base">{s.label}</dt>
        </div>
      ))}
    </dl>
  </section>

  <!-- What carries over to carpentry -->
  {profile.scope.length > 0 && (
    <section class="mx-auto max-w-site px-6 py-16 md:py-24">
      <p class="eyebrow mb-3 text-accent-deep">What carries over</p>
      <h2 class="display mb-10 max-w-3xl text-4xl sm:text-5xl">Formwork skills a carpentry crew can use</h2>
      <ol class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {profile.scope.map((step, i) => (
          <li class="border-t-4 border-ink pt-5">
            <span class="display text-2xl text-accent-deep tabular-nums">0{i + 1}</span>
            <h3 class="mt-3 text-xl font-extrabold">{step.title}</h3>
            <p class="mt-2 text-lg leading-relaxed text-muted">{step.text}</p>
          </li>
        ))}
      </ol>
    </section>
  )}

  <!-- Experience, then Next: TAFE -->
  {(profile.experience.length > 0 || profile.tafe.show) && (
    <section class="bg-white">
      <div class="mx-auto max-w-site px-6 py-16 md:py-24">
        <p class="eyebrow mb-3 text-accent-deep">Experience</p>
        <h2 class="display mb-10 text-4xl sm:text-5xl">Where I've been, what's next</h2>
        <div class="space-y-5">
          {profile.experience.map((job) => (
            <div class="grid gap-3 border-l-8 border-ink bg-paper p-6 md:grid-cols-[1fr_2fr] md:gap-8 md:p-8">
              <p class="eyebrow text-muted">{job.period}</p>
              <div>
                <h3 class="text-2xl font-extrabold">{job.company}</h3>
                {job.role && <p class="mt-1 font-bold text-muted">{job.role}</p>}
                <p class="mt-3 text-lg text-muted">{job.text}</p>
              </div>
            </div>
          ))}
          {profile.tafe.show && (
            <div class="grid gap-3 border-l-8 border-accent bg-paper p-6 md:grid-cols-[1fr_2fr] md:gap-8 md:p-8">
              <p class="eyebrow text-accent-deep">Next · {profile.tafe.start}</p>
              <div>
                <h3 class="text-2xl font-extrabold">{profile.tafe.course}</h3>
                <p class="mt-1 font-bold text-muted">{profile.tafe.institute}</p>
                <p class="mt-3 text-lg text-muted">Coursework and projects will be added here as I go.</p>
              </div>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Selected work -->
  <section id="work" class="mx-auto max-w-site scroll-mt-16 px-6 py-16 md:py-24">
    <header class="mb-10">
      <p class="eyebrow mb-3 text-accent-deep">Selected work</p>
      <h2 class="display text-4xl sm:text-5xl">On site</h2>
    </header>
    <Gallery photos={photos} siteNames={siteNames} />
  </section>

  <!-- Sites by region -->
  <section id="sites" class="scroll-mt-16 bg-white">
    <div class="mx-auto max-w-site px-6 py-16 md:py-24">
      <header class="mb-10">
        <p class="eyebrow mb-3 text-accent-deep">Site history</p>
        <h2 class="display text-4xl sm:text-5xl">Where I've worked</h2>
      </header>
      <div class="space-y-12">
        {regions.map((g) => (
          <div class="grid gap-3 md:grid-cols-[1fr_2fr] md:gap-12">
            <h3 class="flex items-baseline gap-3 text-xl font-extrabold uppercase md:pt-4">
              {g.region}
              <span class="bg-ink px-2 py-0.5 text-sm text-paper tabular-nums">{siteCount(g.sites)}</span>
            </h3>
            <ul class="divide-y divide-line border-y-2 border-ink">
              {g.sites.map((s) => (
                <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4">
                  <span class="text-lg font-bold">{s.data.name}</span>
                  <span class="text-muted">
                    {[s.data.address, s.data.type, period(s)].filter(Boolean).join(' · ')}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="scroll-mt-16 bg-ink text-paper">
    <div class="mx-auto grid max-w-site gap-12 px-6 py-16 md:grid-cols-2 md:py-24">
      <div>
        <p class="eyebrow mb-5 text-accent">Contact</p>
        <h2 class="display max-w-2xl text-4xl sm:text-6xl">
          Need a labourer on your next frame?
          {callHref ? (
            <span class="text-accent"> Give me a call.</span>
          ) : (
            hasContact && <span class="text-accent"> Get in touch.</span>
          )}
        </h2>
        {(callHref || profile.email) && (
          <div class="mt-10 flex flex-wrap gap-3">
            {callHref && <a href={callHref} class="btn btn-accent">Call {profile.phone}</a>}
            {textHref && <a href={textHref} class="btn btn-outline-light">Text me</a>}
            {profile.email && <a href={`mailto:${profile.email}`} class="btn btn-outline-light">Email</a>}
          </div>
        )}
        {(profile.email || profile.linkedin) && (
          <div class="mt-8 flex flex-wrap gap-x-10 gap-y-3 text-lg font-semibold">
            {profile.email && (
              <a href={`mailto:${profile.email}`} class="underline decoration-paper/40 decoration-2 underline-offset-8 hover:decoration-accent">
                {profile.email}
              </a>
            )}
            {profile.linkedin && (
              <a href={profile.linkedin} class="underline decoration-paper/40 decoration-2 underline-offset-8 hover:decoration-accent" rel="noopener">
                LinkedIn
              </a>
            )}
          </div>
        )}
        {profile.formEndpoint && <p class="mt-8 max-w-md text-lg text-paper/70">Or send a message and I'll get back to you.</p>}
      </div>

      <!-- Contact form via Formspree (free) — shown once formEndpoint is set in site.yaml -->
      {profile.formEndpoint && (
        <form method="POST" action={profile.formEndpoint} class="space-y-6 self-end">
          <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />
          {[
            { name: 'name', label: 'Name', type: 'text', auto: 'name' },
            { name: 'contact', label: 'Email or phone', type: 'text', auto: 'email' },
          ].map((f) => (
            <label class="block">
              <span class="eyebrow text-paper/70">{f.label}</span>
              <input
                name={f.name}
                type={f.type}
                autocomplete={f.auto}
                required
                class="mt-2 w-full border-2 border-paper/40 bg-transparent px-3 py-3 text-lg outline-none focus:border-accent"
              />
            </label>
          ))}
          <label class="block">
            <span class="eyebrow text-paper/70">Message</span>
            <textarea
              name="message"
              rows="4"
              required
              class="mt-2 w-full resize-y border-2 border-paper/40 bg-transparent px-3 py-3 text-lg outline-none focus:border-accent"
            ></textarea>
          </label>
          <button type="submit" class="btn btn-accent">Send message</button>
        </form>
      )}
    </div>
  </section>
</Layout>
