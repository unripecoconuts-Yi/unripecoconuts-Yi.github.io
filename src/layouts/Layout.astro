---
import '../styles/global.css';
import { getEntry } from 'astro:content';
import { telHref } from '../lib/contact';

interface Props {
  title?: string;
  description?: string;
}

const profile = (await getEntry('profile', 'profile'))!.data;
const {
  title = `${profile.name} — ${profile.role}, ${profile.location}`,
  description = profile.intro,
} = Astro.props;

const callHref = telHref(profile.phone);
const hasContact = Boolean(profile.phone || profile.email || profile.linkedin || profile.formEndpoint);

const nav = [
  { href: '/#work', label: 'Work' },
  { href: '/#sites', label: 'Sites' },
  { href: '/#contact', label: 'Contact' },
  { href: '/why-demian', label: 'Why dEmiAn?' },
];
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body class="min-h-screen">
    <header class="sticky top-0 z-40 bg-ink text-paper">
      <div class="mx-auto flex h-16 max-w-site items-center justify-between px-6">
        <a href="/" class="display text-lg">{profile.name}</a>
        <nav class="flex items-center gap-7 text-sm font-semibold text-paper/75">
          {nav.map((item) => (
            <a href={item.href} class="hidden transition-colors hover:text-paper sm:inline">{item.label}</a>
          ))}
          {profile.resumePdf && (
            <a href={profile.resumePdf} class="hidden transition-colors hover:text-paper sm:inline">Resume</a>
          )}
          {callHref && (
            <a href={callHref} class="btn btn-accent hidden !min-h-10 !px-4 !text-sm sm:inline-flex">Call {profile.phone}</a>
          )}
          <!-- Mobile: hamburger button (hidden on larger screens) -->
          <button
            id="menu-button"
            type="button"
            class="-mr-2 flex h-12 w-12 items-center justify-center text-paper sm:hidden"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <!-- ☰ icon (shown when closed) -->
            <svg data-icon="open" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" aria-hidden="true">
              <path d="M3 6h18M3 12h18M3 18h18" />
            </svg>
            <!-- ✕ icon (shown when open) -->
            <svg data-icon="close" class="hidden" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" aria-hidden="true">
              <path d="M5 5l14 14M19 5L5 19" />
            </svg>
          </button>
        </nav>
      </div>

      <!-- Mobile menu panel -->
      <nav id="mobile-menu" class="hidden border-t border-paper/15 sm:hidden" aria-label="Mobile">
        <ul class="mx-auto max-w-site px-6 py-2">
          {nav.map((item) => (
            <li class="border-b border-paper/15 last:border-b-0">
              <a href={item.href} class="block py-4 text-lg font-bold tracking-wide uppercase">{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <script>
      const button = document.getElementById('menu-button')!;
      const menu = document.getElementById('mobile-menu')!;
      const openIcon = button.querySelector('[data-icon="open"]')!;
      const closeIcon = button.querySelector('[data-icon="close"]')!;

      function setOpen(open: boolean) {
        menu.classList.toggle('hidden', !open);
        button.setAttribute('aria-expanded', String(open));
        button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        // Swap ☰ for ✕ while open
        openIcon.classList.toggle('hidden', open);
        closeIcon.classList.toggle('hidden', !open);
      }

      button.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
      // Close after picking a section, or when tapping outside / pressing Escape
      menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
      document.addEventListener('click', (e) => {
        if (!button.contains(e.target as Node) && !menu.contains(e.target as Node)) setOpen(false);
      });
      document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
    </script>

    <main>
      <slot />
    </main>

    <!-- Extra bottom padding on phones leaves room for the fixed Call bar -->
    <footer class={`bg-ink text-paper/60 ${hasContact ? 'pb-24 sm:pb-0' : ''}`}>
      <div class="mx-auto flex max-w-site flex-col gap-2 border-t border-paper/15 px-6 py-8 text-sm sm:flex-row sm:justify-between">
        <p>© {new Date().getFullYear()} {profile.name}</p>
        <p>{profile.location}</p>
      </div>
    </footer>

    <!-- Phones only: Call button fixed to the bottom of the screen -->
    {hasContact && (
      <div class="fixed inset-x-0 bottom-0 z-40 border-t border-paper/15 bg-ink p-3 sm:hidden">
        {callHref ? (
          <a href={callHref} class="btn btn-accent w-full">Call {profile.name}</a>
        ) : (
          <a href="/#contact" class="btn btn-accent w-full">Get in touch</a>
        )}
      </div>
    )}
  </body>
</html>
