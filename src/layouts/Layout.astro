---
import '../styles/global.css';
import { getEntry } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
}

const profile = (await getEntry('profile', 'profile'))!.data;
const {
  title = `${profile.name} — ${profile.role}`,
  description = profile.intro,
} = Astro.props;

const nav = [
  { href: '/#work', label: 'Work' },
  { href: '/#sites', label: 'Sites' },
  { href: '/#contact', label: 'Contact' },
];
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body class="min-h-screen">
    <header class="sticky top-0 z-40 border-b border-line/70 bg-paper/85 backdrop-blur">
      <div class="mx-auto flex h-16 max-w-site items-center justify-between px-6">
        <a href="/" class="text-sm font-semibold tracking-tight">{profile.name}</a>
        <nav class="flex items-center gap-6 text-sm text-muted">
          {nav.map((item) => (
            <a href={item.href} class="hidden transition-colors hover:text-ink sm:inline">{item.label}</a>
          ))}
          {profile.resumePdf && (
            <a
              href={profile.resumePdf}
              class="rounded-full border border-ink px-4 py-1.5 text-ink transition-colors hover:bg-ink hover:text-paper"
            >Resume</a>
          )}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-line">
      <div class="mx-auto flex max-w-site flex-col gap-2 px-6 py-10 text-xs text-muted sm:flex-row sm:justify-between">
        <p>© {new Date().getFullYear()} {profile.name}</p>
        <p>{profile.location}</p>
      </div>
    </footer>
  </body>
</html>
