---
import '../styles/global.css';
import { getEntry } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
}

const profile = (await getEntry('profile', 'profile'))!.data;
const {
  title = `${profile.name} — ${profile.role}`,
  description = profile.intro,
} = Astro.props;

const nav = [
  { href: '/#work', label: 'Work' },
  { href: '/#sites', label: 'Sites' },
  { href: '/#contact', label: 'Contact' },
  { href: '/why-demian', label: 'Why dEmiAn?' },
];
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body class="min-h-screen">
    <header class="sticky top-0 z-40 border-b border-line/70 bg-paper/85 backdrop-blur">
      <div class="mx-auto flex h-16 max-w-site items-center justify-between px-6">
        <a href="/" class="text-sm font-semibold tracking-tight">{profile.name}</a>
        <nav class="flex items-center gap-6 text-sm text-muted">
          {nav.map((item) => (
            <a href={item.href} class="hidden transition-colors hover:text-ink sm:inline">{item.label}</a>
          ))}
          {profile.resumePdf && (
            <a
              href={profile.resumePdf}
              class="rounded-full border border-ink px-4 py-1.5 text-ink transition-colors hover:bg-ink hover:text-paper"
            >Resume</a>
          )}
          <!-- Mobile: hamburger button (hidden on larger screens) -->
          <button
            id="menu-button"
            type="button"
            class="-mr-2 flex h-11 w-11 items-center justify-center text-ink sm:hidden"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <!-- ☰ icon (shown when closed) -->
            <svg data-icon="open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
            <!-- ✕ icon (shown when open) -->
            <svg data-icon="close" class="hidden" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18" />
            </svg>
          </button>
        </nav>
      </div>

      <!-- Mobile menu panel -->
      <nav id="mobile-menu" class="hidden border-t border-line/70 sm:hidden" aria-label="Mobile">
        <ul class="mx-auto max-w-site px-6 py-2">
          {nav.map((item) => (
            <li class="border-b border-line/70 last:border-b-0">
              <a href={item.href} class="block py-4 text-lg tracking-tight">{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <script>
      const button = document.getElementById('menu-button')!;
      const menu = document.getElementById('mobile-menu')!;
      const openIcon = button.querySelector('[data-icon="open"]')!;
      const closeIcon = button.querySelector('[data-icon="close"]')!;

      function setOpen(open: boolean) {
        menu.classList.toggle('hidden', !open);
        button.setAttribute('aria-expanded', String(open));
        button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        // Swap ☰ for ✕ while open
        openIcon.classList.toggle('hidden', open);
        closeIcon.classList.toggle('hidden', !open);
      }

      button.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
      // Close after picking a section, or when tapping outside / pressing Escape
      menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
      document.addEventListener('click', (e) => {
        if (!button.contains(e.target as Node) && !menu.contains(e.target as Node)) setOpen(false);
      });
      document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
    </script>

    <main>
      <slot />
    </main>

    <footer class="border-t border-line">
      <div class="mx-auto flex max-w-site flex-col gap-2 px-6 py-10 text-xs text-muted sm:flex-row sm:justify-between">
        <p>© {new Date().getFullYear()} {profile.name}</p>
        <p>{profile.location}</p>
      </div>
    </footer>
  </body>
</html>
